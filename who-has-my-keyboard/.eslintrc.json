{
  "root": true,
  "env": {
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["error", { "args": "none" }]
  },
  "overrides": [
    {
      "files": ["server/**/*.js"],
      "env": { "node": true }
    },
    {
      "files": ["client/**/*.js"],
      "env": { "browser": true },
      "globals": {
        "angular": "readonly",
        "io": "readonly",
        "GameState": "readonly",
        "GameEngine": "readonly",
        "InputManager": "readonly",
        "Collision": "readonly",
        "Sprites": "readonly",
        "Animations": "readonly",
        "HUD": "readonly",
        "MapRenderer": "readonly",
        "PlayerEntity": "readonly",
        "DuckEntity": "readonly",
        "PowerUpEntity": "readonly"
      }
    }
  ]
}
